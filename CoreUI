		Corner(Box, 12)
		Stroke(Box, Theme.StrokeHi, 1.5, 0)
		Pad(Box, 18, 16, 18, 16)
		List(Box, 12)
		Sc = New("UIScale", { Scale = 0.92 }, Box)
		Tween(Sc, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)

		local TitleRow = New("Frame", { LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 1 }, Box)
