							Panel:Refresh()
							Good("Deleted \"" .. Name .. "\".")
						end,
					},
				},
			})
		end,
	})

	Panel.Section, Panel.Dropdown, Panel.Input = Sec, Dd, NameInput
	function Panel:GetSelected() return Selected() end
	return Panel
