		Chip.BackgroundColor3 = FillC:Lerp(White, 0.3)
		Tween(Chip, 0.25, { BackgroundColor3 = FillC })
		Call(O.Callback)
	end)
	function Obj:SetText(T)
		for _, D in ipairs(Chip:GetDescendants()) do
			if D:IsA("TextLabel") then D.Text = tostring(T) break end
