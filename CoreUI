	if O.Icon and O.Icon ~= "" then
		local IS = O.IconSize or 20
		Ico = IconLabel(Head, O.Icon, IS, Theme.Accent, { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0) }, "•")
		TextX = IS + 10
	end

	local Column = New("Frame", {
